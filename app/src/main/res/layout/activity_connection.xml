<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/connection_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/colorSurface">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/connection_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content"
        app:title="@string/connection_status_title" app:navigationIcon="@drawable/ic_back" app:navigationContentDescription="@string/connection_back" />
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/connection_progress" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:indeterminate="true" android:visibility="gone" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/connection_content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp" android:paddingBottom="32dp">
            <TextView android:id="@+id/connection_headline" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" android:accessibilityHeading="true" />
            <TextView android:id="@+id/connection_phase" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.button.MaterialButton android:id="@+id/connection_check"
                android:layout_width="wrap_content" android:layout_gravity="end" android:layout_height="wrap_content" android:minHeight="48dp"
                android:layout_marginTop="20dp" android:text="@string/connection_check" android:textAllCaps="false" />
            <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="20dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_account"
                android:textAppearance="?attr/textAppearanceTitleMedium" android:accessibilityHeading="true" />
            <TextView android:id="@+id/connection_account_value" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.button.MaterialButton android:id="@+id/connection_account_action" style="@style/Widget.GDirect.Button.Text"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false"
                android:text="@string/drive_connect" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:text="@string/connection_api" android:textAppearance="?attr/textAppearanceTitleMedium" android:accessibilityHeading="true" />
            <TextView android:id="@+id/connection_api_value" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/connection_api_time" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:text="@string/connection_download" android:textAppearance="?attr/textAppearanceTitleMedium" android:accessibilityHeading="true" />
            <TextView android:id="@+id/connection_download_value" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/connection_download_time" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="20dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_mode"
                android:textAppearance="?attr/textAppearanceTitleMedium" android:accessibilityHeading="true" />
            <TextView android:id="@+id/connection_mode_value" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.button.MaterialButton android:id="@+id/connection_settings" style="@style/Widget.GDirect.Button.Text"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:text="@string/connection_change_mode" />
            <com.google.android.material.button.MaterialButton android:id="@+id/connection_logs" style="@style/Widget.GDirect.Button.Text"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:text="@string/connection_view_logs" />
            <com.google.android.material.button.MaterialButton android:id="@+id/connection_technical_toggle" style="@style/Widget.GDirect.Button.Text"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_technical_details" android:textAllCaps="false" />
            <LinearLayout android:id="@+id/connection_technical_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="@string/connection_evidence_note" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/connection_route_details" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" android:textIsSelectable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
