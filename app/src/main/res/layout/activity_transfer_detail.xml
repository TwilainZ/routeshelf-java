<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/transfer_detail_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/colorSurface" android:focusableInTouchMode="true">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/transfer_detail_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:title="@string/ui_transfer_detail_title" app:navigationIcon="@drawable/ic_back" app:navigationContentDescription="@string/connection_back" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/transfer_detail_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/transfer_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_current_transfer" android:textAppearance="?attr/textAppearanceTitleLarge" android:accessibilityHeading="true" />
            <TextView android:id="@+id/transfer_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceBodyLarge" android:accessibilityLiveRegion="polite" />
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/transfer_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:max="1000" android:visibility="gone" />
            <TextView android:id="@+id/transfer_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/transfer_open" android:layout_width="wrap_content" android:layout_gravity="end" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="24dp" android:text="@string/ui_open_file" android:textAllCaps="false" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/transfer_stop" style="@style/Widget.GDirect.Button.Outlined" android:layout_width="wrap_content" android:layout_gravity="end" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="24dp" android:text="@string/ui_cancel_transfer" android:textAllCaps="false" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/transfer_empty_action" style="@style/Widget.GDirect.Button.Outlined" android:layout_width="wrap_content" android:layout_gravity="end" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="24dp" android:text="@string/ui_public_file" android:textAllCaps="false" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/transfer_logs" style="@style/Widget.GDirect.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp" android:text="@string/connection_view_logs" android:textAllCaps="false" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
