<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="dev.gdirect.lite" />
        <package android:name="com.google.android.gms" />
    </queries>
    <application android:label="@string/probe_title" android:theme="@style/InspectorTheme"
        android:allowBackup="false" android:fullBackupContent="false" android:usesCleartextTraffic="false">
        <activity android:name=".PackageProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
